# Este arquivo é sobrescrito automaticamente pelo "tofu apply" (iac/main.tf).
# Se precisar editar manualmente, troque os IPs abaixo pelos IPs públicos das VMs.
[web]
vm1 ansible_host=IP_PUBLICO_VM1

[api]
vm2 ansible_host=IP_PUBLICO_VM2

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=ansible/avaliacao_key.pem
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
